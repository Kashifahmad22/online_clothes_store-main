PORT=4000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Required in production (integer 0-5); see README "Proxy trust and rate limiting". Development may leave it unset.
TRUST_PROXY_HOPS=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public storefront origin for canonical URLs, social previews and the sitemap (HTTPS origin, no path).
# Optional: falls back to the current Vercel storefront. Set it to the custom domain once chosen.
SITE_URL=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
