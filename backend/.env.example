PORT=4000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Required in production (integer 0-5); see README "Proxy trust and rate limiting". Development may leave it unset.
TRUST_PROXY_HOPS=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public storefront origin for canonical URLs, social previews and the sitemap (HTTPS origin, no path).
# Optional: falls back to the current Vercel storefront. Set it to the custom domain once chosen.
SITE_URL=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Transactional email (optional). Without SMTP_HOST and EMAIL_FROM, email notifications are recorded as skipped.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (typically port 465); defaults to true only when SMTP_PORT=465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. Brand Name <orders@your-domain>. Use an address on a domain you control and have authenticated.
EMAIL_FROM=
# WhatsApp Cloud API (optional). Each event is sent only if its approved template name is set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_PLACED=
WHATSAPP_TEMPLATE_PAYMENT_SUCCESS=
WHATSAPP_TEMPLATE_ORDER_DISPATCHED=
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
WHATSAPP_TEMPLATE_RETURN_APPROVED=
WHATSAPP_TEMPLATE_REFUND_PROCESSED=
